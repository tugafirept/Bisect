{
  "name": "bisect",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Bisect — daily puzzle: one straight line to split a country as close to 50/50 as you can.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "data": "npm run data:countries && npm run data:population && npm run data:rivers",
    "data:countries": "tsx scripts/build-countries.ts",
    "data:population": "tsx scripts/build-population.ts",
    "data:rivers": "tsx scripts/build-rivers.ts"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "polygon-clipping": "^0.15.7"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.14",
    "adm-zip": "^0.6.0",
    "mapshaper": "^0.7.55",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
